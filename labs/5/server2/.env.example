# Copier en .env et remplir les valeurs.

# === Connexion DB (commune) ===
DB_HOST=your-db-host.aivencloud.com
DB_PORT=10946
DB_NAME=defaultdb

# === Utilisateur en ECRITURE (POST / bouton Insert) : SELECT, INSERT, CREATE ===
DB_WRITE_USER=lab5_writer
DB_WRITE_PASSWORD=

# === Utilisateur en LECTURE SEULE (GET / textarea SQL) : SELECT uniquement ===
DB_READ_USER=lab5_reader
DB_READ_PASSWORD=

# === Port du serveur HTTP (origine 2) ===
PORT=3000
